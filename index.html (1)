function esc(s){return s.replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));}
function add(html, cls){
  const d = document.createElement("div");
  d.className = "cb-msg " + cls;
  if (cls === "me") d.textContent = html; else d.innerHTML = html;
  log.appendChild(d); log.scrollTop = log.scrollHeight;
  return d;
}
function chips(list){
  chipsEl.innerHTML = "";
  list.forEach(q => {
    const b = document.createElement("button");
    b.type = "button"; b.className = "cb-chip"; b.textContent = T(q);
    b.addEventListener("click", () => ask(T(q)));
    chipsEl.appendChild(b);
  });
}
function hit(text, kws){
  let score = 0;
  kws.forEach(k => {
    if (/^[\x00-\x7f]+$/.test(k)) {
      const re = new RegExp("(^|[^a-z])" + k.replace(/[.*+?^${}()|[\]\\]/g,"\\$&") + (k.length <= 3 ? "($|[^a-z])" : ""), "i");
      if (re.test(text)) score += k.length;
    } else if (text.includes(k)) score += k.length * 2;
  });
  return score;
}
function moreBtn(label, fn){
