    add(T({ko:"<b>응급 상황일 수 있어요. 지금 바로 911에 전화하거나 가까운 응급실로 가세요.</b> 보험은 나중에 처리할 수 있어요. 입원하게 되면 48시간 안에 Cowan(1-833-377-8447)에 알리면 돼요.",
           en:"<b>This could be an emergency. Call 911 or go to the nearest ER now.</b> Insurance can be sorted out later. If you're admitted, tell Cowan (1-833-377-8447) within 48 hours."}), "bot alert");
    return;
  }
  let best = null, bestScore = 0;
  S.forEach(s => { const sc = hit(text, KW[s.id] || []); if (sc > bestScore) { bestScore = sc; best = {type:"s", v:s}; } });
  EXTRA.forEach(x => { const sc = hit(text, x.kw); if (sc > bestScore) { bestScore = sc; best = {type:"x", v:x}; } });
  if (!best) {
    add(T({ko:"아직 그 질문은 잘 모르겠어요. 아래 버튼처럼 진료 종류(치과, 약, 상담, 물리치료 등)를 넣어서 물어봐 주세요. 정확한 답이 필요하면 UTSU(416-978-4911)나 Cowan(1-833-377-8447)에 문의하세요.",
           en:"I'm not sure about that one yet. Try naming the type of care (dental, prescriptions, counselling, physio…) like the buttons below. For an exact answer, contact the UTSU (416-978-4911) or Cowan (1-833-377-8447)."}), "bot");
    chips(START);
    return;
  }
  if (best.type === "s") answerSituation(best.v);
  else {
    const d = add(T(best.v.a), "bot");
    if (best.v.go) d.appendChild(moreBtn(T({ko:"페이지에서 보기", en:"View on page"}), () => jump(best.v.go)));
  }
}
function ask(q){
  q = q.trim(); if (!q) return;
  add(q, "me");
  chipsEl.innerHTML = "";
  setTimeout(() => reply(q), 250);
}
let started = false;
function open(){
  panel.classList.add("open"); launch.setAttribute("aria-expanded","true");
  if (!started) {
    started = true;
    add(T({ko:"안녕하세요! Unclaimed FAQ 봇이에요. UHIP이나 UTSU 플랜으로 무엇이 커버되는지, 어떻게 청구하는지 물어보세요.",
           en:"Hi! I'm the Unclaimed FAQ bot. Ask me what UHIP or the UTSU plan covers and how to claim."}), "bot");
    chips(START);
  }
  input.focus();
}
function close(){ panel.classList.remove("open"); launch.setAttribute("aria-expanded","false"); launch.focus(); }
launch.addEventListener("click", () => panel.classList.contains("open") ? close() : open());
document.getElementById("cb-x").addEventListener("click", close);
document.addEventListener("keydown", e => { if (e.key === "Escape" && panel.classList.contains("open")) close(); });
document.getElementById("cb-form").addEventListener("submit", e => { e.preventDefault(); const v = input.value; input.value = ""; ask(v); });
})();
</script>

